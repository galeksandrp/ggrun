diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index a7d382886..8265f5520 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -2260,12 +2260,23 @@ private:
 
         while (slot.prompt.checkpoints.size() >= (size_t) params_base.n_ctx_checkpoints) {
             // make room for the new checkpoint, if needed
-            const auto & cur = slot.prompt.checkpoints.front();
+            auto it = slot.prompt.checkpoints.begin();
+
+            // Preserve the startup anchor (the earliest checkpoint, the one with the
+            // smallest pos_min) across capacity eviction. It is the only checkpoint
+            // that can match apply_checkpoint's `pos_min == 0` escape when a branch
+            // rewinds near the start of a long conversation; evicting it forces a
+            // full prompt re-process of the whole conversation. When the front is
+            // the anchor and a newer checkpoint exists to evict instead, keep it.
+            if (std::next(it) != slot.prompt.checkpoints.end()) {
+                ++it;
+            }
+            const auto & cur = *it;
 
             SLT_WRN(slot, "erasing old context checkpoint (pos_min = %d, pos_max = %d, n_tokens = %" PRId64 ", size = %.3f MiB)\n",
                     cur.pos_min, cur.pos_max, cur.n_tokens, (float) cur.size() / 1024 / 1024);
 
-            slot.prompt.checkpoints.erase(slot.prompt.checkpoints.begin());
+            slot.prompt.checkpoints.erase(it);
         }
 
         auto & cur = slot.prompt.checkpoints.emplace_back();
