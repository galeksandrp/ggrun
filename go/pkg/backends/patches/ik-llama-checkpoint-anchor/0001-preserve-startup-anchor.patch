diff --git a/examples/server/server-context.cpp b/examples/server/server-context.cpp
index 5ed5a395..8e4f3b7b 100644
--- a/examples/server/server-context.cpp
+++ b/examples/server/server-context.cpp
@@ -3718,7 +3718,17 @@ bool server_context::create_checkpoint(server_slot & slot) {
             if (params_base.ctx_checkpoint_eviction == COMMON_CHECKPOINT_EVICTION_VARIANCE ||
                 params_base.ctx_checkpoint_eviction == COMMON_CHECKPOINT_EVICTION_AUTO) {
                 it = evict_checkpoint_by_variance(slot, slot.server_cached_prompt.checkpoints);
-            } 
+            }
+            // Preserve the startup anchor (the earliest checkpoint, the one with the
+            // smallest pos_min) across capacity eviction. It is the only checkpoint
+            // that can match apply_checkpoint's `pos_min == 0` escape when a branch
+            // rewinds near the start of a long conversation; evicting it forces a
+            // full prompt re-process of the whole conversation. When the chosen
+            // victim is the anchor, evict the next-oldest checkpoint instead.
+            if (it == slot.server_cached_prompt.checkpoints.begin() &&
+                std::next(it) != slot.server_cached_prompt.checkpoints.end()) {
+                std::advance(it, 1);
+            }
             const auto & cur = *it;
             SLT_WRN(slot, "erasing old context checkpoint (pos_min = %d, pos_max = %d, n_tokens = %" PRId64 ", size = %.3f MiB)\n",
                 cur.pos_min, cur.pos_max, cur.n_tokens, (float)cur.data.size() / 1024 / 1024);
